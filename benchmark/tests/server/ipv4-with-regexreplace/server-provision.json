[
  {
    "requestMethod": "POST",
    "requestUri": "/app/v1/benchmark/ipv4",
    "responseCode": 200,
    "responseBody": {"ipv4": ""},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {"source": "requestBody", "path": "/phone"},
        "filter": [
          {
            "op": "regexReplace",
            "rgx": "[0-9]*([0-9]{2})([0-9]{2})([0-9]{2})([0-9]{2})",
            "fmt": "$1.$2.$3.$4"
          }
        ],
        "to": {"target": "var", "name": "digits"}
      },
      {
        "from": {"source": "var", "name": "digits"},
        "filter": [{"op": "cast", "type": "string"}],
        "to": {"target": "responseBody", "path": "/ipv4"}
      }
    ]
  }
]
