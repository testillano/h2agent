[
  {
    "requestMethod": "POST",
    "requestUri": "/app/v1/load-test/id-21",
    "responseCode": 200,
    "responseBody": {
      "status": "ok",
      "company": "<to be replaced by vault entry>",
      "uriId": 0,
      "timestampUs": 0,
      "requestAge": 0,
      "doubleAge": 0
    },
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {"source": "vault", "key": "company"},
        "filter": [{"op": "cast", "type": "string"}],
        "to": {"target": "responseBody", "path": "/company"}
      },
      {
        "from": {"source": "requestUriPath"},
        "filter": [
          {"op": "regexReplace", "rgx": "/app/v1/load-test/id-([0-9]+)", "fmt": "$1"},
          {"op": "cast", "type": "unsigned"}
        ],
        "to": {"target": "responseBody", "path": "/uriId"}
      },
      {
        "from": {"source": "timestamp", "unit": "us"},
        "filter": [{"op": "cast", "type": "unsigned"}],
        "to": {"target": "responseBody", "path": "/timestampUs"}
      },
      {"from": {"source": "requestBody", "path": "/age"}, "to": {"target": "var", "name": "age"}},
      {
        "from": {"source": "var", "name": "age"},
        "filter": [{"op": "cast", "type": "unsigned"}],
        "to": {"target": "responseBody", "path": "/requestAge"}
      },
      {
        "from": {"source": "math", "expression": "@{age} * 2"},
        "filter": [{"op": "cast", "type": "unsigned"}],
        "to": {"target": "responseBody", "path": "/doubleAge"}
      }
    ]
  }
]
