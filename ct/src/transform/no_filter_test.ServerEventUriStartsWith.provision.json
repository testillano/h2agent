[
  {
    "requestMethod": "POST",
    "requestUri": "/app/v1/resources/.*",
    "responseCode": 201,
    "responseBody": {"stored": true},
    "responseHeaders": {"content-type": "application/json"}
  },
  {
    "requestMethod": "GET",
    "requestUri": "/app/v1/last-resource",
    "responseCode": 200,
    "responseBody": {"foo": "bar"},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {
          "source": "serverEvent",
          "requestMethod": "POST",
          "requestUriStartsWith": "/app/v1/resources/",
          "eventNumber": -1,
          "eventPath": "/requestBody"
        },
        "filter": [{"op": "cast", "type": "object"}],
        "to": {"target": "responseBody", "path": "/lastResourceBody"}
      }
    ]
  }
]
