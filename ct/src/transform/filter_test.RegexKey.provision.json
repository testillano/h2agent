{
  "requestMethod": "POST",
  "requestUri": "/app/v1/foo/bar/1",
  "responseCode": 200,
  "responseBody": {"foo": "bar-1"},
  "responseHeaders": {"content-type": "application/json"},
  "transform": [
    {
      "from": {"source": "requestBody", "path": "/cart"},
      "filter": [{"op": "regexKey", "rgx": "order-[0-9]*-express"}],
      "to": {"target": "vault", "key": "item"}
    },
    {
      "from": {"source": "vault", "key": "item", "path": "/price"},
      "filter": [{"op": "cast", "type": "integer"}],
      "to": {"target": "responseBody", "path": "/price"}
    }
  ]
}
