[
  {
    "requestMethod": "GET",
    "requestUri": "/app/v1/seq-test/data",
    "responseCode": 200,
    "responseBody": {"origin": "seq-test"},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [{"from": {"source": "recvseq"}, "to": {"target": "vault", "key": "lastRecvSeq"}}]
  },
  {
    "requestMethod": "POST",
    "requestUri": "/app/v1/seq-test/read-by-seq",
    "responseCode": 200,
    "responseBody": {"status": "pending"},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {
          "source": "serverEvent",
          "requestMethod": "GET",
          "requestUri": "/app/v1/seq-test/data",
          "recvseq": "@{lastRecvSeq}",
          "eventPath": "/responseBody"
        },
        "filter": [{"op": "cast", "type": "object"}],
        "to": {"target": "responseBody", "path": "/readResult"}
      }
    ]
  },
  {
    "requestMethod": "POST",
    "requestUri": "/app/v1/seq-test/erase-by-seq",
    "responseCode": 200,
    "responseBody": {"erased": true},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {"source": "eraser"},
        "to": {
          "target": "serverEvent",
          "requestMethod": "GET",
          "requestUri": "/app/v1/seq-test/data",
          "recvseq": "@{lastRecvSeq}"
        }
      }
    ]
  }
]
