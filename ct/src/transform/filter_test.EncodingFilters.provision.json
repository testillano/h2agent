      "from": {"source": "requestHeader", "name": "x-context"},
      "filter": [{"op": "base64Decode"}, {"op": "cast", "type": "json"}],
      "to": {"target": "responseBody", "path": "/context"}
    },
    {
      "from": {"source": "requestBody", "path": "/sessionId"},
