{
  "requestMethod": "POST",
  "requestUri": "/app/v1/foo/bar/1",
  "responseCode": 200,
  "responseBody": {"foo": "bar-1"},
  "responseHeaders": {"content-type": "application/json"},
  "transform": [
    {
      "from": {"source": "requestBody", "path": "/Title"},
      "filter": [{"op": "hexToText"}],
      "to": {"target": "responseBody", "path": "/title"}
    },
    {
      "from": {"source": "requestBody", "path": "/Address"},
      "filter": [{"op": "hexToIp"}],
      "to": {"target": "responseBody", "path": "/ipv4"}
    },
    {
      "from": {"source": "requestBody", "path": "/Address6"},
      "filter": [{"op": "hexToIp"}],
      "to": {"target": "responseBody", "path": "/ipv6"}
    },
    {
      "from": {"source": "literal", "value": "library.example"},
      "filter": [{"op": "textToHex"}],
      "to": {"target": "responseBody", "path": "/titleHex"}
    },
    {
      "from": {"source": "requestBody", "path": "/Bad-Text"},
      "filter": [{"op": "hexToText"}],
      "to": {"target": "responseBody", "path": "/bad"},
      "onFilterFail": [
        {"from": {"source": "literal", "value": "not text"}, "to": {"target": "responseBody", "path": "/bad"}}
      ]
    }
  ]
}
