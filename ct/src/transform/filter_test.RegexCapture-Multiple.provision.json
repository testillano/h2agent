{
  "requestMethod": "GET",
  "requestUri": "/app/v1/foo/bar/1",
  "responseCode": 200,
  "responseBody": {"foo": "bar-1"},
  "responseHeaders": {"content-type": "text/html", "x-version": "1.0.0"},
  "transform": [
    {
      "from": {"source": "requestUri"},
      "filter": [{"op": "regexCapture", "rgx": "/app/v1/([a-z]*)/bar/([0-9]*)"}],
      "to": {"target": "var", "name": "captures"}
    },
    {
      "from": {"source": "var", "name": "captures.1"},
      "filter": [{"op": "cast", "type": "string"}],
      "to": {"target": "responseBody", "path": "/captureFooFromURI"}
    },
    {
      "from": {"source": "var", "name": "captures.2"},
      "filter": [{"op": "cast", "type": "string"}],
      "to": {"target": "responseBody", "path": "/captureBarIdFromURI"}
    },
    {
      "from": {"source": "var", "name": "captures.3"},
      "filter": [{"op": "cast", "type": "string"}],
      "to": {"target": "responseBody", "path": "/thisShouldBeSkipped"}
    },
    {
      "from": {"source": "var", "name": "captures"},
      "filter": [{"op": "cast", "type": "string"}],
      "to": {"target": "responseBody", "path": "/variableAsIs"}
    }
  ]
}
