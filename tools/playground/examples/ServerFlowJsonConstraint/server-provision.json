{
  "requestMethod": "GET",
  "requestUri": "/validate",
  "responseCode": 200,
  "responseBody": {"foo": "bar", "completed": true},
  "transform": [
    {"from": {"source": "random", "min": 1, "max": 5}, "to": {"target": "var", "name": "R"}},
    {
      "from": {"source": "literal", "value": "test_@{R}"},
      "to": {"target": "responseBody", "path": "/id"}
    },
    {
      "from": {"source": "literal", "value": "[\"@{R}\", \"2\"]"},
      "filter": [{"op": "cast", "type": "json"}],
      "to": {"target": "responseBody", "path": "/randoms"}
    },
    {
      "from": {"source": "responseBody"},
      "filter": [{"op": "jsonConstraint", "value": {"id": "test_2", "randoms": ["2", "2"]}}],
      "to": {"target": "var", "name": "expectedBody"}
    },
    {
      "from": {"source": "literal", "value": "417"},
      "filter": [{"op": "conditionVar", "name": "expectedBody", "not": true}],
      "to": {"target": "responseStatusCode"}
    }
  ]
}
