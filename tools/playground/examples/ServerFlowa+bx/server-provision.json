{
  "requestMethod": "GET",
  "requestUri": "/give/me/random/calculation",
  "responseCode": 200,
  "transform": [
    {"from": {"source": "random", "min": 0, "max": 9}, "to": {"target": "var", "name": "a"}},
    {"from": {"source": "random", "min": 0, "max": 9}, "to": {"target": "var", "name": "b"}},
    {"from": {"source": "random", "min": 0, "max": 9}, "to": {"target": "var", "name": "x"}},
    {
      "from": {"source": "math", "expression": "@{a} + @{b}*@{x}"},
      "to": {"target": "var", "name": "result"}
    },
    {
      "from": {"source": "literal", "value": "a + bx = @{result}, for a=@{a}, b=@{b} and x=@{x}"},
      "to": {"target": "responseBodyText"}
    }
  ]
}
