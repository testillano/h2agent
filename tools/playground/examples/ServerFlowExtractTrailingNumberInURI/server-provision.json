{
  "requestMethod": "GET",
  "requestUri": "/app/v1/foo/bar/",
  "responseCode": 200,
  "transform": [
    {
      "from": {"source": "requestUri"},
      "filter": [{"op": "regexReplace", "rgx": "/app/v1/foo/bar/([0-9]*)", "fmt": "$1"}],
      "to": {"target": "responseBody", "path": "/capturedValue"}
    }
  ]
}
