{
  "requestMethod": "GET",
  "requestUri": "/divide/by/two",
  "responseCode": 200,
  "responseHeaders": {"content-type": "application/json"},
  "transform": [
    {"from": {"source": "literal", "value": "100"}, "to": {"target": "var", "name": "previous"}},
    {
      "from": {
        "source": "serverEvent",
        "requestMethod": "GET",
        "requestUri": "/divide/by/two",
        "eventNumber": -1,
        "eventPath": "/responseBody/current"
      },
      "to": {"target": "var", "name": "previous"}
    },
    {
      "from": {"source": "math", "expression": "@{previous}/2"},
      "to": {"target": "var", "name": "current"}
    },
    {
      "from": {"source": "literal", "value": "@{previous}"},
      "filter": [{"op": "cast", "type": "object"}],
      "to": {"target": "responseBody", "path": "/previous"}
    },
    {
      "from": {"source": "literal", "value": "@{current}"},
      "filter": [{"op": "cast", "type": "object"}],
      "to": {"target": "responseBody", "path": "/current"}
    }
  ]
}
