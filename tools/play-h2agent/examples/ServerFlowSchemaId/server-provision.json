{
  "requestMethod": "POST",
  "requestUri": "/validate",
  "requestSchemaId": "myRequestSchema",
  "responseCode": 200,
  "transform": [
    {
      "from": {"source": "requestBody"},
      "filter": [{"op": "schemaId", "id": "myFilterSchema"}],
      "to": {"target": "var", "name": "expectedBody"}
    },
    {
      "from": {"source": "literal", "value": "417"},
      "filter": [{"op": "conditionVar", "name": "expectedBody", "not": true}],
      "to": {"target": "responseStatusCode"}
    },
    {
      "from": {"source": "var", "name": "expectedBody.fail"},
      "filter": [{"op": "cast", "type": "string"}],
      "to": {"target": "responseBody", "path": "/failReport"}
    }
  ]
}
