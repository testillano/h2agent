[
  {
    "requestMethod": "POST",
    "requestUri": "/cart",
    "inState": "initial",
    "outState": "has-items",
    "responseCode": 200,
    "responseBody": {"step": "first"},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {
        "from": {"source": "requestBody", "path": "/price"},
        "to": {"target": "var", "name": "total"}
      },
      {
        "from": {"source": "var", "name": "total"},
        "filter": [{"op": "cast", "type": "integer"}],
        "to": {"target": "responseBody", "path": "/running"}
      }
    ]
  },
  {
    "requestMethod": "POST",
    "requestUri": "/cart",
    "inState": "has-items",
    "outState": "has-items",
    "responseCode": 200,
    "responseBody": {"step": "added"},
    "responseHeaders": {"content-type": "application/json"},
    "transform": [
      {"from": {"source": "var", "name": "total"}, "to": {"target": "var", "name": "accumulated"}},
      {
        "from": {"source": "requestBody", "path": "/price"},
        "to": {"target": "var", "name": "newPrice"}
      },
      {
        "from": {"source": "math", "expression": "@{accumulated}+@{newPrice}"},
        "to": {"target": "var", "name": "total"}
      },
      {
        "from": {"source": "var", "name": "total"},
        "filter": [{"op": "cast", "type": "integer"}],
        "to": {"target": "responseBody", "path": "/running"}
      }
    ]
  }
]
