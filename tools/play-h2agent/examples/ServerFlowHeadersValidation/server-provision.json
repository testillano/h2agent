{
  "requestMethod": "GET",
  "requestUri": "/api/v1/resource",
  "responseCode": 200,
  "responseBody": {"status": "authorized", "message": "Welcome"},
  "transform": [
    {
      "from": {"source": "requestHeaders"},
      "filter": [
        {
          "op": "jsonConstraint",
          "value": [
            {"name": "x-api-key", "value": "my-secret-key"},
            {"name": "x-client-id", "value": "service-a"}
          ]
        }
      ],
      "to": {"target": "var", "name": "headersOK"}
    },
    {
      "from": {"source": "literal", "value": "403"},
      "filter": [{"op": "conditionVar", "name": "headersOK", "not": true}],
      "to": {"target": "responseStatusCode"}
    },
    {
      "from": {"source": "var", "name": "headersOK.fail"},
      "filter": [{"op": "conditionVar", "name": "headersOK", "not": true}],
      "to": {"target": "responseBodyText"}
    }
  ]
}
